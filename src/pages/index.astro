---
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>川哥的博客</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Noto Sans SC', sans-serif;
      background: #fafafa;
      color: #222;
      min-height: 100vh;
      line-height: 1.7;
    }
    a { color: inherit; text-decoration: none; }
    .container {
      max-width: 640px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    header {
      padding: 4rem 0 3rem;
      border-bottom: 1px solid #eee;
      margin-bottom: 3rem;
    }
    header h1 {
      font-size: 1.6rem;
      font-weight: 500;
      letter-spacing: -0.02em;
    }
    header p {
      font-size: 0.85rem;
      color: #999;
      margin-top: 0.3rem;
    }

    .posts { list-style: none; }
    .post-item {
      padding: 1.5rem 0;
      border-bottom: 1px solid #f0f0f0;
    }
    .post-item:last-child { border-bottom: none; }
    .post-item a { display: block; }
    .post-item a:hover .post-title { color: #666; }
    .post-title {
      font-size: 1.1rem;
      font-weight: 400;
      margin-bottom: 0.3rem;
      transition: color 0.2s;
    }
    .post-meta {
      font-size: 0.78rem;
      color: #bbb;
      font-family: monospace;
    }
    .post-desc {
      font-size: 0.88rem;
      color: #888;
      margin-top: 0.4rem;
      font-weight: 300;
    }

    footer {
      padding: 3rem 0;
      text-align: center;
      font-size: 0.75rem;
      color: #ccc;
    }

    @media (max-width: 600px) {
      header { padding: 2.5rem 0 2rem; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>川哥的博客</h1>
      <p>记录想法与折腾</p>
    </header>

    <ul class="posts">
      {posts.map(post => (
        <li class="post-item">
          <a href={`/blog/${post.id}`}>
            <div class="post-title">{post.data.title}</div>
            <div class="post-meta"><FormattedDate date={post.data.pubDate} /></div>
            <div class="post-desc">{post.data.description}</div>
          </a>
        </li>
      ))}
    </ul>

    <footer>© 2026</footer>
  </div>
</body>
</html>
