---
const posts = [
  { 
    slug: 'first', 
    title: 'Astro 初体验 - 极快的静态站点框架', 
    date: '2026-04-27', 
    tags: ['Astro', '前端', '静态博客'],
    category: '技术',
    excerpt: 'Astro 是一个专注于内容驱动的 Web 框架，它的核心卖点是「服务器优先渲染」和几乎零 JavaScript 输出。' 
  },
  { 
    slug: 'second', 
    title: '为什么我选择静态博客', 
    date: '2026-04-25', 
    tags: ['静态博客', '工具'],
    category: '技术',
    excerpt: '静态博客有很多优点：加载快、SEO 友好、安全、无服务器成本，维护简单。' 
  },
  { 
    slug: '洛克之路', 
    title: '摩旅甘南秘境——洛克之路', 
    date: '2024-08-15', 
    tags: ['摩旅', '甘南', '洛克之路', '旅行'],
    category: '旅行',
    excerpt: '甘南川西环线摩旅之旅，眼睛上天堂，轮胎下地狱。扎尕那、洛克之路、拉卜楞寺...' 
  },
  { 
    slug: 'third', 
    title: 'GitHub Trending 怎么看', 
    date: '2026-04-24', 
    tags: ['GitHub', '工具'],
    category: '工具',
    excerpt: '今天 GitHub 有哪些项目在飙升？mattpocock/skills 暴涨 2.5k+ star。' 
  },
];

const categories = [...new Set(posts.map(p => p.category))];
const tags = [...new Set(posts.flatMap(p => p.tags))];
const sortedPosts = [...posts].sort((a, b) => new Date(b.date) - new Date(a.date));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>博客</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --bg: rgba(0, 0, 0, 0.02);
        --card: rgba(255, 255, 255, 0.7);
        --card-hover: rgba(255, 255, 255, 0.9);
        --text: #1a1a1a;
        --text-secondary: #666;
        --text-muted: #999;
        --accent: #667eea;
        --border: rgba(0, 0, 0, 0.06);
      }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg);
        background-attachment: fixed;
        color: var(--text);
        min-height: 100vh;
        line-height: 1.7;
      }
      .container { max-width: 680px; margin: 0 auto; padding: 0 1.5rem; }

      /* 头部 */
      header {
        padding: 4rem 0 2.5rem;
        text-align: center;
      }
      header h1 {
        font-size: 2rem;
        font-weight: 600;
        letter-spacing: -0.03em;
        color: var(--text);
        margin-bottom: 0.3rem;
      }
      header p {
        font-size: 0.9rem;
        color: var(--text-muted);
        font-weight: 300;
      }

      /* 分类横滑 */
      .categories {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        padding: 0.5rem 0 1.5rem;
        scrollbar-width: none;
        -ms-overflow-style: none;
        white-space: nowrap;
      }
      .categories::-webkit-scrollbar { display: none; }
      .cat-btn {
        flex-shrink: 0;
        padding: 0.35rem 0.9rem;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 50px;
        font-size: 0.8rem;
        color: var(--text-secondary);
        text-decoration: none;
        backdrop-filter: blur(10px);
        transition: all 0.2s;
      }
      .cat-btn:hover, .cat-btn.active {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
      }

      /* 标签 */
      .tags {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
        justify-content: center;
      }
      .tag {
        font-size: 0.72rem;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        transition: all 0.2s;
      }
      .tag:hover { color: var(--accent); background: rgba(102,126,234,0.08); }

      /* 文章列表 */
      .posts { display: flex; flex-direction: column; gap: 1rem; }
      .post {
        background: var(--card);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.5rem 1.75rem;
        text-decoration: none;
        color: inherit;
        display: block;
        transition: all 0.25s ease;
      }
      .post:hover {
        background: var(--card-hover);
        transform: translateY(-3px);
        box-shadow: 0 8px 30px rgba(102,126,234,0.1);
        border-color: rgba(102,126,234,0.2);
      }
      .post h2 {
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--text);
        margin-bottom: 0.4rem;
        line-height: 1.4;
      }
      .post .meta {
        font-size: 0.78rem;
        color: var(--text-muted);
        margin-bottom: 0.6rem;
        font-family: 'JetBrains Mono', monospace;
      }
      .post .excerpt {
        font-size: 0.9rem;
        color: var(--text-secondary);
        line-height: 1.7;
        font-weight: 300;
      }
      .post .post-tags {
        display: flex;
        gap: 0.35rem;
        margin-top: 0.75rem;
        flex-wrap: wrap;
      }
      .post .post-tag {
        font-size: 0.7rem;
        color: var(--text-muted);
        background: rgba(0,0,0,0.04);
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
      }

      /* 底部留白 */
      .spacer { height: 4rem; }

      @media (max-width: 600px) {
        header { padding: 2.5rem 0 2rem; }
        header h1 { font-size: 1.6rem; }
        .post { padding: 1.25rem; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1>博客</h1>
        <p>记录想法与折腾</p>
      </header>

      <div class="categories">
        <a href="/" class="cat-btn active">全部</a>
        {categories.map(cat => (
          <a href={`/category/${cat}`} class="cat-btn">{cat}</a>
        ))}
      </div>

      <div class="tags">
        {tags.map(tag => (
          <a href={`/tag/${tag}`} class="tag">{tag}</a>
        ))}
      </div>

      <main class="posts">
        {sortedPosts.map(post => (
          <a href={`/posts/${post.slug}`} class="post">
            <h2>{post.title}</h2>
            <div class="meta">{post.date} · {post.readTime ?? post.category}</div>
            <p class="excerpt">{post.excerpt}</p>
            <div class="post-tags">
              {post.tags.map(tag => <span class="post-tag">{tag}</span>)}
            </div>
          </a>
        ))}
      </main>

      <div class="spacer"></div>
    </div>
  </body>
</html>
