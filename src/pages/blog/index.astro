---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="文章" description="川哥的博客 - 记录想法与折腾">
	<div class="mx-auto max-w-2xl lg:max-w-4xl">
		<header class="mb-20 max-w-2xl">
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">
				文章
			</h1>
			<p class="text-slate-600 dark:text-slate-400">
				共 {posts.length} 篇文章
			</p>
		</header>

		<section>
			<div class="space-y-12">
				{posts.map((post) => (
					<article class="relative group">
						<a href={`/blog/${post.id}`} class="absolute inset-0" />
						<div class="relative">
							<h2 class="text-xl font-semibold group-hover:text-slate-500 dark:group-hover:text-slate-300 transition">
								{post.data.title}
							</h2>
							<time class="text-sm font-mono text-slate-500 mt-1 block">
								<FormattedDate date={post.data.pubDate} />
							</time>
							<p class="mt-3 text-slate-600 dark:text-slate-400 leading-relaxed">
								{post.data.description}
							</p>
							<span class="mt-4 text-sm font-medium text-slate-400 group-hover:text-slate-700 dark:group-hover:text-slate-200 transition">
								阅读全文 →
							</span>
						</div>
					</article>
				))}
			</div>
		</section>
	</div>
</BaseLayout>
